# Configuración del examen de comandos (la lee examen.sh).
# NO pongas aquí tu nombre: se guarda en config.local.env (no se sube a git).

# Dirección del servidor del examen (a través del proxy del aula). Sin barra final.
SERVIDOR_URL="http://192.168.2.1/examen-comandos"

# Clave compartida para que el servidor acepte entregas. Debe coincidir con CLAVE de
# apps/examen-comandos/.env en el repo del servidor.
CLAVE="som-examen-2026"

# Qué examen es: el servidor agrupa las entregas por este nombre.
EXAMEN="1T-2026-27"

# Poner "no" sólo para probar el examen sin entregar nada.
ENVIAR="si"
